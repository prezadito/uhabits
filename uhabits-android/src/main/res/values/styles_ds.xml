<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Ds" parent="android:TextAppearance"/>

    <style name="TextAppearance.Ds.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dsInk</item>
    </style>
    <style name="TextAppearance.Ds.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dsInk</item>
    </style>
    <style name="TextAppearance.Ds.HabitName">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Ds.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">?attr/dsInk</item>
    </style>
    <style name="TextAppearance.Ds.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dsInk</item>
    </style>
    <style name="TextAppearance.Ds.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">?attr/dsInkMuted</item>
    </style>
</resources>
