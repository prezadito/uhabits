<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/ds_space_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/ds_space_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_note"
            android:src="@drawable/ic_delete"
            app:tint="@color/note_delete" />
    </FrameLayout>

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_16"
        android:layout_marginEnd="@dimen/ds_space_16"
        android:layout_marginTop="@dimen/ds_space_8"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_event"
        android:drawablePadding="@dimen/ds_space_8"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:textAppearance="@style/TextAppearance.Ds.Caption" />

    <EditText
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/note"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:paddingStart="@dimen/ds_space_16"
        android:paddingTop="@dimen/ds_space_16"
        android:paddingEnd="@dimen/ds_space_16"
        android:paddingBottom="@dimen/ds_space_16"
        android:textAppearance="@style/TextAppearance.Ds.Body" />
</LinearLayout>
