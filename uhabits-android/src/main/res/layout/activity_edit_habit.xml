<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.habits.edit.EditHabitActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/dsSurface"
            android:gravity="end"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/dsToolbarTheme"
            app:contentInsetStart="@dimen/ds_space_16"
            app:title="@string/create_habit"
            app:titleTextAppearance="@style/TextAppearance.Ds.TitleLarge"
            app:titleTextColor="?attr/dsInk">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/ds_space_8"
                android:text="@string/save"
                android:textAppearance="@style/TextAppearance.Ds.Label"
                android:textColor="?attr/dsAccent" />
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:background="?attr/dsSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/ds_space_16"
            android:paddingLeft="@dimen/ds_space_16"
            android:paddingRight="@dimen/ds_space_16">

            <!-- Title and color -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Habit Title -->
                <LinearLayout
                    style="@style/FormOuterBox"
                    android:layout_width="0dp"
                    android:layout_weight="1">
<TextView
                            style="@style/FormLabel"
                            android:text="@string/name" />
<LinearLayout style="@style/FormInnerBox">
                        <EditText
                            android:id="@+id/nameInput"
                            style="@style/FormInput"
                            android:maxLines="2"
                            android:maxLength="50"
                            android:inputType="textCapSentences|textMultiLine"
                            android:hint="@string/yes_or_no_short_example"
                            />
                    </LinearLayout>
</LinearLayout>

                <!-- Habit Color -->
                <LinearLayout
                    style="@style/FormOuterBox"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_16">
                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/color" />
                    <LinearLayout
                        android:id="@+id/colorButton"
                        style="@style/FormInnerBox"
                        android:layout_width="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ds_space_16"
                        android:paddingEnd="@dimen/ds_space_16">
                        <View
                            android:id="@+id/colorSwatch"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/ds_color_swatch"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/colorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_12"
                            android:textAppearance="@style/TextAppearance.Ds.Body" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Habit Icon -->
            <LinearLayout style="@style/FormOuterBox">
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/icon" />
                <LinearLayout
                    android:id="@+id/iconButton"
                    style="@style/FormInnerBox"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_space_16">
                    <TextView
                        android:id="@+id/iconPreview"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textSize="26sp" />
                    <TextView
                        android:id="@+id/iconName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:textAppearance="@style/TextAppearance.Ds.Body" />
                </LinearLayout>
            </LinearLayout>

            <!-- Habit Question -->
            <LinearLayout style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/question" />
<LinearLayout style="@style/FormInnerBox">
                    <EditText
                        android:id="@+id/questionInput"
                        style="@style/FormInput"
                        android:inputType="textCapSentences|textMultiLine"
                        android:hint="@string/example_question_boolean"
                         />
                </LinearLayout>
</LinearLayout>

            <!-- Frequency -->
            <LinearLayout
                android:id="@+id/frequencyOuterBox"
                style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/frequency" />
<LinearLayout style="@style/FormInnerBox">
                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/boolean_frequency_picker"
                        android:text="@string/every_day" />
                </LinearLayout>
</LinearLayout>

            <!-- Quit date and time -->
            <LinearLayout
                android:id="@+id/quitSinceOuterBox"
                style="@style/FormOuterBox"
                android:visibility="gone">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/quit_since" />
<LinearLayout style="@style/FormInnerBox">

                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/quitDatePicker"
                        android:text="" />

                    <View style="@style/FormDivider" />

                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/quitTimePicker"
                        android:text="" />
                </LinearLayout>
</LinearLayout>

            <!-- Target value, unit and frequency -->
            <LinearLayout
                android:id="@+id/unitOuterBox"
                style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/unit" />
<LinearLayout style="@style/FormInnerBox">
                    <EditText
                        style="@style/FormInput"
                        android:id="@+id/unitInput"
                        android:maxLines="1"
                        android:ems="10"
                        android:hint="@string/measurable_units_example"/>
                </LinearLayout>
</LinearLayout>

            <LinearLayout
                android:id="@+id/targetOuterBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    style="@style/FormOuterBox"
                    android:layout_width="0dp"
                    android:layout_weight="1">
<TextView
                            style="@style/FormLabel"
                            android:text="@string/target" />
<LinearLayout style="@style/FormInnerBox">
                        <EditText
                            style="@style/FormInput"
                            android:id="@+id/targetInput"
                            android:maxLines="1"
                            android:inputType="numberDecimal"
                            android:hint="@string/example_target"/>
                    </LinearLayout>
</LinearLayout>
                <LinearLayout
                    style="@style/FormOuterBox"
                    android:layout_width="0dp"
                    android:layout_weight="1">
<TextView
                            style="@style/FormLabel"
                            android:text="@string/frequency" />
<LinearLayout style="@style/FormInnerBox">
                        <TextView
                            style="@style/FormDropdown"
                            android:id="@+id/numericalFrequencyPicker"
                            android:text="@string/every_week"
                            android:textColor="?attr/contrast100"
                            />
                    </LinearLayout>
</LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/targetTypeOuterBox"
                style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/target_type" />
<LinearLayout style="@style/FormInnerBox">
                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/targetTypePicker"
                        android:textColor="?attr/contrast100"
                        />
                </LinearLayout>
</LinearLayout>


            <!-- Reminder -->
            <LinearLayout style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/reminder" />
<LinearLayout style="@style/FormInnerBox">

                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/reminderTimePicker"
                        android:text="@string/reminder_off" />

                    <View
                        style="@style/FormDivider"
                        android:id="@+id/reminderDivider"/>

                    <TextView
                        style="@style/FormDropdown"
                        android:id="@+id/reminderDatePicker"
                        android:text="" />
                </LinearLayout>
</LinearLayout>


            <!-- Notes -->
            <LinearLayout style="@style/FormOuterBox">
<TextView
                        style="@style/FormLabel"
                        android:text="@string/notes" />
<LinearLayout style="@style/FormInnerBox">

                    <EditText
                        android:id="@+id/notesInput"
                        style="@style/FormInput"
                        android:inputType="textCapSentences|textMultiLine"
                        android:hint="@string/example_notes" />
                </LinearLayout>
</LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
