<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/ds_space_16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_16"
        android:text="@string/create_habit"
        android:textAppearance="@style/TextAppearance.Ds.TitleLarge" />

    <LinearLayout
        android:id="@+id/buttonYesNo"
        style="@style/SelectHabitTypeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SelectHabitTypeButtonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yes_or_no" />

            <TextView
                style="@style/SelectHabitTypeButtonBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yes_or_no_example" />
        </LinearLayout>

        <TextView style="@style/SelectHabitTypeButtonChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonMeasurable"
        style="@style/SelectHabitTypeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SelectHabitTypeButtonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/measurable" />

            <TextView
                style="@style/SelectHabitTypeButtonBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/measurable_example" />
        </LinearLayout>

        <TextView style="@style/SelectHabitTypeButtonChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonQuit"
        style="@style/SelectHabitTypeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SelectHabitTypeButtonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quit_habit" />

            <TextView
                style="@style/SelectHabitTypeButtonBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quit_habit_example" />
        </LinearLayout>

        <TextView style="@style/SelectHabitTypeButtonChevron" />
    </LinearLayout>

</LinearLayout>
