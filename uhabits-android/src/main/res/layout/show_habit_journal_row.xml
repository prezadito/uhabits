<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journalDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Ds.Label"
            tools:text="Thursday, October 23, 2026" />

        <TextView
            android:id="@+id/journalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:textAppearance="@style/TextAppearance.Ds.Label"
            tools:text="Done" />
    </LinearLayout>

    <TextView
        android:id="@+id/journalNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/contrast100"
        tools:text="Felt great today, ran a bit further than usual." />
</LinearLayout>
