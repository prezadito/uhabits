<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:habit="http://isoron.org/android">

    <TextView
        android:id="@+id/title"
        style="@style/CardHeader"
        android:text="@string/overview"/>

    <LinearLayout
        android:id="@+id/llOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.isoron.uhabits.activities.common.views.RingView
            android:id="@+id/scoreRing"
            android:layout_width="@dimen/ds_ring_lg"
            android:layout_height="@dimen/ds_ring_lg"
            habit:percentage="0"
            habit:textSize="14"
            habit:thickness="6"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/monthDiffLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="@dimen/ds_text_habit_name"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/month"
                android:textAppearance="@style/TextAppearance.Ds.Caption"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/yearDiffLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="@dimen/ds_text_habit_name"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/year"
                android:textAppearance="@style/TextAppearance.Ds.Caption"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="@dimen/ds_text_habit_name"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/totalCountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total"
                android:textAppearance="@style/TextAppearance.Ds.Caption"/>

        </LinearLayout>
    </LinearLayout>
</merge>
