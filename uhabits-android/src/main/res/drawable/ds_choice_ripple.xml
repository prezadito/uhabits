<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:colorControlHighlight">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/dsAccentTint"/>
                    <stroke android:width="2dp" android:color="?attr/dsAccent"/>
                    <corners android:radius="@dimen/ds_radius_lg"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/dsAccentTint"/>
                    <stroke android:width="2dp" android:color="?attr/dsAccent"/>
                    <corners android:radius="@dimen/ds_radius_lg"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/dsSurfaceRaised"/>
                    <stroke android:width="1dp" android:color="?attr/dsLineStrong"/>
                    <corners android:radius="@dimen/ds_radius_lg"/>
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="@dimen/ds_radius_lg"/>
        </shape>
    </item>
</ripple>
