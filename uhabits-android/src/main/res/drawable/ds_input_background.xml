<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsSurfaceRaised"/>
            <stroke android:width="2dp" android:color="?attr/dsAccent"/>
            <corners android:radius="@dimen/ds_radius_sm"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsSurfaceRaised"/>
            <stroke android:width="1dp" android:color="?attr/dsLineStrong"/>
            <corners android:radius="@dimen/ds_radius_sm"/>
        </shape>
    </item>
</selector>
